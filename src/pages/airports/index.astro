---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import BrandCard from '../../components/BrandCard.astro';
import BrandTable from '../../components/BrandTable.astro';
import Faq from '../../components/Faq.astro';
import { BRANDS, PICKS_ORDER } from '../../data/brands';

const ordered = [...PICKS_ORDER, ...Object.keys(BRANDS).filter((id) => !PICKS_ORDER.includes(id))];
const withPage = ordered.filter((id) => BRANDS[id]!.slug);
const entryOnly = ordered.filter((id) => !BRANDS[id]!.slug);
const cardIds = PICKS_ORDER.slice(0, 7);
const faq = [
  { q: '机场导航里的排序是测速名次吗？', a: '不是。无忧链接排第一是因为它的价格、线路、协议、节点都写在官方页面上，资料最完整；其余按资料完整度排列。本站没有测速数据，也不对速度与稳定性作保证。' },
  { q: '表里的“暂无资料”是什么意思？', a: '表示本站没有找到可核实的公开资料，不会替它编造价格、线路或节点。想了解可以打开官网入口自己核对。' },
  { q: '价格为什么写“年付折算”？', a: '不同服务商的计费方式不同。本站标明口径：包月起步价、年付折算价分开写，不直接比较。价格以官网结算页为准。' },
];
---

<BaseLayout
  title="机场导航｜机场代理服务商目录与资料对照"
  description="火箭机场机场导航：收录 29 个机场品牌入口，价格、线路、协议、节点逐条标注来源，首推无忧链接；缺资料的写暂无，没有测速排名，价格以官网为准。"
  keywords={['机场导航', '机场代理', '机场推荐', '机场目录']}
>
  <PageShell h1="机场导航：机场代理服务商目录" crumbs={[{ name: '机场导航', href: '/airports/' }]} lead="本站所说的“机场”指机场代理服务商，与航班、航站楼无关。这里按资料完整度整理，首推无忧链接；价格、线路、协议、节点逐条标注来源，缺资料就写“暂无”。" meta={['机场代理资料库', '更新 2026-09-26', '本站未发布测速排名']}>
    <div class="keybox"><span class="keybox-label">怎么用这份导航</span><p>先看资料相对完整的前几家，挑 2 家买最低档包月，晚高峰自己测几天，再决定续费哪一家。方法见 <a href="/tools/latency-loss/">延迟丢包计算器</a> 与 <a href="/method/">资料与测试说明</a>。</p></div>

    <h2>资料相对完整的机场</h2>
    <div class="bc-list bc-list--3d">
      {cardIds.map((id, i) => <BrandCard brand={BRANDS[id]!} rank={i + 1} top={i === 0} />)}
    </div>

    <h2>价格、线路、协议、节点并排</h2>
    <BrandTable ids={withPage} />

    <h2>只登记官方入口的品牌</h2>
    <p>下面这些品牌本站只登记了官方入口，价格、线路、协议、节点与客户端一律写“暂无可核实的公开资料”。</p>
    <ul class="quick-links">
      {entryOnly.map((id) => <li><a href={BRANDS[id]!.aff} target="_blank" rel="nofollow noopener sponsored">{BRANDS[id]!.name}</a></li>)}
    </ul>

    <Faq items={faq} />
    <div class="related-block">
      <h2>相关阅读</h2>
      <ul>
        <li><a href="/rankings/">机场推荐榜</a></li>
        <li><a href="/rankings/best-value/">性价比机场</a></li>
        <li><a href="/knowledge/how-to-choose-an-airport-proxy/">机场代理怎么选</a></li>
        <li><a href="/knowledge/what-if-airport-shuts-down/">机场跑路了怎么办</a></li>
      </ul>
    </div>
  </PageShell>
</BaseLayout>
