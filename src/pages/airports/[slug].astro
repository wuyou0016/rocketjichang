---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import BrandTable from '../../components/BrandTable.astro';
import Faq from '../../components/Faq.astro';
import { BRANDS, PICKS_ORDER, WUYOU_PLANS, has, priceLine, srcLabel, AFF_REL, type Brand } from '../../data/brands';
import { getArticleHref } from '../../data/utils/article-routing';
import { resolveCanonicalUrl } from '../../config/seo';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  return Object.values(BRANDS)
    .filter((b) => b.slug)
    .map((b) => ({ params: { slug: b.slug! }, props: { id: b.id } }));
}

const { id } = Astro.props;
const b: Brand = BRANDS[id]!;
const isWuyou = b.id === 'wuyou';

// 已有的品牌评测文章（沿用 /knowledge/ 下的旧 URL）
const reviewArticleIds: Record<string, string> = {
  wuyou: 'wuyou-lianjie-review',
  firefly: 'firefly-review',
  kuajie: 'kuajie-cloud-review',
  lingmao: 'lingmao-network-review',
  shanyue: 'shanyue-review',
  weifeng: 'weifeng-network-review',
};
const articles = await getCollection('articles');
const review = articles.find((a) => a.id === reviewArticleIds[b.id]);

const others = PICKS_ORDER.filter((x) => x !== b.id).slice(0, 5);
const hasData = b.tier !== 4;
const title = hasData ? `${b.name}怎么样：价格、线路、协议与资料来源` : `${b.name}：官方入口与资料状态`;
const desc = hasData
  ? `${b.name}资料页：${priceLine(b).slice(0, 40)}；${has(b.line) ? '线路' + b.line.replace(/（.*?）/g, '').slice(0, 20) + '；' : ''}资料性质${srcLabel(b)}，本站没有测速数据，价格以官网为准。`
  : `${b.name}官方入口与资料状态：本站只登记了官方推广入口，价格、线路、协议、节点暂无可核实的公开资料，请以官网页面为准。`;
const faq = [
  { q: `${b.name}的价格是多少？`, a: `${priceLine(b)}。价格与活动以官网结算页为准，本站不在品牌之间比较流量大小。` },
  { q: `${b.name}的资料从哪里来？`, a: `资料性质：${srcLabel(b)}。${b.source}。本站没有测速与实测数据，也不对速度与稳定性作保证。` },
  { q: `第一次买${b.name}怎么买最稳妥？`, a: '先买最低档的包月，晚高峰连测几天（方法见[延迟丢包计算器](/tools/latency-loss/)），确认稳定后再考虑更长周期，买年付前先问清退款规则。' },
];
const path = `/airports/${b.slug}/`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: desc,
  dateModified: '2026-09-26',
  author: { '@type': 'Organization', name: siteConfig.author.name },
  url: resolveCanonicalUrl(path),
};
---

<BaseLayout title={title} description={desc} keywords={[b.name, `${b.name}机场`, `${b.name}怎么样`]} ogType="article" modifiedTime="2026-09-26">
  <PageShell h1={hasData ? `${b.name}怎么样：价格、线路、协议与资料来源` : `${b.name}：官方入口与资料状态`} crumbs={[{ name: '机场导航', href: '/airports/' }, { name: b.name, href: path }]} lead={b.tagline} meta={['品牌资料', '更新 2026-09-26', `资料性质：${srcLabel(b)}`]}>
    <div class="keybox"><span class="keybox-label">先看结论</span><p>{b.fit}。{b.caution}</p></div>

    <h2>价格、线路、协议、节点</h2>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>项目</th><th>资料</th></tr></thead>
        <tbody>
          <tr><th scope="row">价格与口径</th><td>{priceLine(b)}</td></tr>
          <tr><th scope="row">线路</th><td>{has(b.line) ? b.line : '暂无资料'}</td></tr>
          <tr><th scope="row">协议</th><td>{has(b.protocols) ? b.protocols : '暂无资料'}</td></tr>
          <tr><th scope="row">节点地区</th><td>{has(b.nodes) ? b.nodes : '暂无资料'}</td></tr>
          <tr><th scope="row">客户端</th><td>{has(b.client) ? b.client : '暂无资料'}</td></tr>
          <tr><th scope="row">资料性质</th><td>{srcLabel(b)}（{b.source}）</td></tr>
        </tbody>
      </table>
    </div>

    {
      isWuyou && (
        <>
          <h2>三档套餐（官方页面）</h2>
          <div class="tbl-wrap">
            <table class="tbl">
              <thead><tr><th>档位</th><th>计费</th><th>价格</th></tr></thead>
              <tbody>
                {WUYOU_PLANS.map((p) => <tr><th scope="row">{p.name}</th><td>{p.billing.replace('，低至', '')}</td><td>{/低至/.test(p.billing) ? '低至' : '约'} ¥{p.m}/月{p.name === '省心' ? '起' : ''}</td></tr>)}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {
      b.facts.length > 0 && (
        <>
          <h2>已整理的事实</h2>
          <ul>{b.facts.map((f) => <li>{f}</li>)}</ul>
        </>
      )
    }

    <h2>适合谁，要注意什么</h2>
    <p><strong>适合：</strong>{b.fit}。</p>
    <p><strong>注意：</strong>{b.caution}</p>

    <p><a class="btn btn-aff btn-lg" href={b.aff} target="_blank" rel={AFF_REL}>访问{b.name}官网</a> <span class="bc-disc">联盟推广链接，价格以官网为准</span></p>

    <h2>自己验证的四步</h2>
    <ol class="lst">
      <li>买最低档<strong>包月</strong>，不要一上来买年付。</li>
      <li>连续几个晚高峰记录延迟与丢包，方法见 <a href="/tools/latency-loss/">延迟丢包计算器</a>。</li>
      <li>试你真正要用的场景：网页、视频、AI 工具，见 <a href="/ai-airport/">AI 场景</a> 与 <a href="/streaming-airport/">流媒体场景</a>。</li>
      <li>一周后再决定续费或换周期，另备一个低价备用。</li>
    </ol>

    {
      review && (
        <p>延伸阅读：<a href={getArticleHref(review)}>{review.data.title}</a></p>
      )
    }

    <h2>和其他机场并排看</h2>
    <BrandTable ids={[b.id, ...others]} cols={['price', 'line', 'protocols', 'src']} />

    <Faq items={faq} />
  </PageShell>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</BaseLayout>
