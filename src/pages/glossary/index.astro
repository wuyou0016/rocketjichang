---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/PageShell.astro';
import { isDemoEntry } from '../../data/utils/demo-filter';

const terms = await getCollection('glossary', ({ id }) => !isDemoEntry(id));
---

<BaseLayout
  title="机场代理术语表｜SNI、TUN、Reality 等概念通俗解释｜火箭机场"
  description="机场代理术语表：SNI、ECH、TUN 模式、Reality、WireGuard、落地 IP、家宽 IP 等常见技术概念的通俗解释，帮助你看懂机场套餐页、客户端设置和排错信息。"
>
  <PageShell h1="机场代理术语表｜常见概念与名词解释" crumbs={[{ name: '术语表', href: '/glossary/' }]}>
  <p>这里收录机场代理相关的常见术语与名词解释。</p>

  <h2>已收录的术语</h2>
  {
    terms.length > 0 ? (
      <ul class="quick-links">
        {terms.map((term) => (
          <li>
            <a href={`/glossary/${term.id}/`}>{term.data.term}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p>当前暂无已发布术语。</p>
    )
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/knowledge/">了解机场代理知识</a></li>
  </ul>
</PageShell>
</BaseLayout>
