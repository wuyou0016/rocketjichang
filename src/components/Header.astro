---
import { siteConfig } from '../config/site';

// 主导航：顺序按“先找机场，再按场景，再学习”排列。
const navItems = [
  { label: '机场导航', href: '/airports/' },
  { label: '推荐榜', href: '/rankings/' },
  { label: 'VPN', href: '/vpn/' },
  { label: '梯子', href: '/ladder/' },
  { label: 'AI', href: '/ai-airport/' },
  { label: '流媒体', href: '/streaming-airport/' },
  { label: '客户端', href: '/setup-guides/' },
  { label: '知识库', href: '/knowledge/' },
];

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<a class="skip sr" href="#main">跳到正文</a>
<header class="hd">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${siteConfig.brandName}首页`}>
      <svg class="cube" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 4 42 14v20L24 44 6 34V14z" fill="#0e1230" stroke="#22d3ee" stroke-width="2.2" stroke-linejoin="round" />
        <path d="M6 14l18 10 18-10M24 24v20" fill="none" stroke="#a78bfa" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M24 11c3 2.6 4 6.4 4 9.8 0 1.4-.3 2.6-.7 3.6h-6.6c-.4-1-.7-2.2-.7-3.6 0-3.4 1-7.2 4-9.8z" fill="#22d3ee" />
        <circle cx="24" cy="18" r="1.6" fill="#0e1230" />
        <path d="M22 26.5h4l-1.2 3.8a.9.9 0 0 1-1.6 0z" fill="#fbbf24" />
      </svg>
      <span>
        <b>{siteConfig.brandName}</b>
        <small>ROCKETJICHANG · 机场代理资料库</small>
      </span>
    </a>
    <nav class="site-nav" id="siteNav" aria-label="主导航">
      {navItems.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <button class="theme-btn" id="themeBtn" type="button" aria-pressed="false">明暗</button>
    <button class="nav-btn" id="navBtn" type="button" aria-expanded="false" aria-controls="siteNav">菜单</button>
  </div>
</header>
