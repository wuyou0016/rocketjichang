---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { siteConfig } from '../config/site';
import { resolveCanonicalUrl, type RobotsDirective } from '../config/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  robots?: RobotsDirective;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
}

const { title, description, robots, ogType, ogImage, publishedTime, modifiedTime, keywords } = Astro.props;
const pathname = Astro.url.pathname;
const homepageUrl = resolveCanonicalUrl('/');

// 网站级 JSON-LD：只在此处生成一次，覆盖全站，不逐页重复声明。
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.brandName,
  url: homepageUrl,
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.brandName,
  url: homepageUrl,
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#060814" />
    <script is:inline>
      // 首次绘制前设置 data-theme，避免闪烁。优先级：本站保存的选择 > 默认深色。
      (function () {
        try {
          var s = localStorage.getItem('rj-theme');
          document.documentElement.setAttribute('data-theme', s === 'light' || s === 'dark' ? s : 'dark');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <SEOHead
      title={title}
      description={description}
      pathname={pathname}
      robots={robots}
      ogType={ogType}
      ogImage={ogImage}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
    />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <Analytics />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var tb = document.getElementById('themeBtn');
        function sync() { if (tb) tb.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark' ? 'true' : 'false'); }
        if (tb) {
          tb.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('rj-theme', next); } catch (e) {}
            sync();
          });
        }
        sync();
        var nb = document.getElementById('navBtn'), nav = document.getElementById('siteNav');
        if (nb && nav) {
          nb.addEventListener('click', function () {
            var open = nav.classList.toggle('open');
            nb.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        }
        var rm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hv = window.matchMedia && window.matchMedia('(hover: hover)').matches;
        var sc = document.getElementById('scene'), hg = document.getElementById('heroGrid');
        if (sc && hg && !rm && hv) {
          hg.addEventListener('pointermove', function (e) {
            var r = hg.getBoundingClientRect();
            var x = (e.clientX - r.left) / (r.width || 1) - 0.5, y = (e.clientY - r.top) / (r.height || 1) - 0.5;
            sc.style.setProperty('--ry', (x * 16).toFixed(1) + 'deg');
            sc.style.setProperty('--rx', (-y * 12).toFixed(1) + 'deg');
          });
          hg.addEventListener('pointerleave', function () { sc.style.setProperty('--ry', '0deg'); sc.style.setProperty('--rx', '0deg'); });
        }
        if (!rm && hv) {
          [].slice.call(document.querySelectorAll('[data-tilt],.t3')).forEach(function (el) {
            el.addEventListener('pointermove', function (e) {
              var r = el.getBoundingClientRect();
              var x = (e.clientX - r.left) / (r.width || 1) - 0.5, y = (e.clientY - r.top) / (r.height || 1) - 0.5;
              el.style.setProperty('--ry', (x * 6).toFixed(1) + 'deg');
              el.style.setProperty('--rx', (-y * 6).toFixed(1) + 'deg');
            });
            el.addEventListener('pointerleave', function () { el.style.setProperty('--ry', '0deg'); el.style.setProperty('--rx', '0deg'); });
          });
        }
        var tocLinks = document.querySelectorAll('.toc a[href^="#"]');
        if (tocLinks.length && 'IntersectionObserver' in window) {
          var map = {};
          tocLinks.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting) {
                tocLinks.forEach(function (a) { a.classList.remove('on'); });
                var a = map[e.target.id];
                if (a) a.classList.add('on');
              }
            });
          }, { rootMargin: '0px 0px -70% 0px' });
          Object.keys(map).forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
        }
      })();
    </script>
  </body>
</html>
